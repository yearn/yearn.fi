# Optional: enables WalletConnect and the full wallet list. Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional: Ethereum RPC. Public fallback endpoints are used when unset.
NEXT_PUBLIC_RPC_URI_FOR_1=
# Optional: override the shared Yearn token and network image source.
NEXT_PUBLIC_BASE_YEARN_ASSETS_URI=
