# Preferred public RPC overrides by canonical chain ID (JSON object). Never put server-only credentials here.
NEXT_PUBLIC_CHAIN_RPC_URLS={}

# Legacy per-chain aliases below remain supported; the shared map takes precedence.
# Optional: enable WalletConnect alongside injected wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Optional: override public RPC defaults with production providers.
NEXT_PUBLIC_RPC_ETHEREUM=
NEXT_PUBLIC_RPC_BASE=
NEXT_PUBLIC_RPC_ARBITRUM=
NEXT_PUBLIC_RPC_OPTIMISM=
NEXT_PUBLIC_RPC_POLYGON=
NEXT_PUBLIC_RPC_ROBINHOOD=
