{
  "name": "yearn-workspace",
  "version": "0.3.7",
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run dev:yearn",
    "dev:client": "bun run dev:yearn",
    "dev:yearn": "bun run --cwd apps/yearn dev",
    "dev:ts": "bun run --cwd apps/yearn dev:ts",
    "tenderly": "bun scripts/tenderly.ts",
    "build": "bun run build:yearn",
    "build:yearn": "bun run --cwd apps/yearn build",
    "preview": "bun run preview:yearn",
    "preview:client": "bun run preview:yearn",
    "preview:yearn": "bun run --cwd apps/yearn start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "measure:ssr": "bun scripts/measure-ssr-baseline.ts",
    "check:client-server-boundary": "bun scripts/check-client-server-boundary.ts",
    "tslint": "bun run tslint:yearn",
    "tslint:yearn": "bun run --cwd apps/yearn tslint",
    "test": "bun run test:yearn",
    "test:yearn": "bun run --cwd apps/yearn test",
    "check:yearn": "bun run tslint:yearn && bun run test:yearn && bun run build:yearn",
    "bump": "bump",
    "clean": "bash clean.sh",
    "prepare": "husky"
  },
  "overrides": {
    "qr": "0.5.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "25.3.0",
    "bump": "0.2.5",
    "husky": "9.1.7",
    "lint-staged": "16.2.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
